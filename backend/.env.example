# Ejemplo de variables de entorno del backend.
# Copia este archivo a .env y ajusta los valores según tu entorno.

# Puerto y host donde escucha la API (0.0.0.0 permite conexiones de red local)
PORT=3000
HOST=0.0.0.0

# Conexión a MariaDB / MySQL (XAMPP por defecto: usuario root, sin contraseña)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_facturacion

# Secreto para firmar los tokens JWT (cámbialo en producción)
JWT_SECRET=cambia_este_secreto_por_uno_seguro
JWT_EXPIRES_IN=8h

# Datos de la empresa (aparecen en PDF y tickets)
EMPRESA_NOMBRE=Nombre de la empresa
EMPRESA_DOCUMENTO=NIT 000.000.000-0
EMPRESA_DIRECCION=Direccion
EMPRESA_TELEFONO=+00 000 000 0000
EMPRESA_CIUDAD=Ciudad
EMPRESA_EMAIL=contacto@empresa.co
EMPRESA_MONEDA=COP
